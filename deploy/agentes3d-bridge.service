[Unit]
Description=agentes3d bridge (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/agentes3d/bridge
Environment=AGENTES_ROOT=/root/agentes
Environment=HERMES_UNIT_PREFIX=hermes-
Environment=AGENTES3D_DATA=/root/.agentes3d
Environment=AGENTES3D_TEMPLATE=/root/agentes/agente0
ExecStart=/root/agentes3d/bridge/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8700 --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/agentes3d-bridge.log
StandardError=append:/var/log/agentes3d-bridge.log

[Install]
WantedBy=multi-user.target
